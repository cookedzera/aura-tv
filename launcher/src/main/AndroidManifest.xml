<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.aura.home">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- the Wi-Fi sheet: join, leave and switch networks; Android only lists nearby networks to apps with location -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Continue Watching: read Android TV's Watch Next list (granted at setup) -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- hold OK on an app, then Uninstall: Android shows its own confirmation -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Settings > Updates: installs a newer release from GitHub, after Android's own confirmation -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Settings > Block ads switches the TV's Private DNS to AdGuard DNS; granted once over ADB at setup -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- the Wi-Fi sheet reads the connected network's name from the Wi-Fi status report; granted over ADB at setup -->
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- usage history for For You and Today; activated once over ADB with "appops set ... GET_USAGE_STATS allow" -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Wikimedia Picture of the Day, fetched in a background job that survives reboots -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/app_icon"
        android:banner="@drawable/banner"
        android:theme="@style/Aura"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|layoutDirection|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Aura in the TV's own app list, with an Open button after installing: without it a TV
             that keeps Home for its own launcher gave no way to open Aura at all -->
        <activity-alias
            android:name=".Open"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- the screensaver's settings link (res/xml/dream.xml): Aura opens on its Wallpaper page -->
        <activity-alias
            android:name=".SaverSettings"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name" />

        <service
            android:name=".Ambient"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream" />
        </service>

        <!-- Home twice from inside an app: the switcher straight over it (optional, Settings) -->
        <service
            android:name=".HomeKeys"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_keys" />
        </service>

        <receiver
            android:name=".SleepAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".SleepReceiver" android:exported="false" />
        <receiver android:name=".Updater$Done" android:exported="false" />

        <!-- Now Playing: approved over ADB as a notification listener so Android shares media sessions -->
        <service
            android:name=".MediaWatch"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".DailyJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- restore script hook: only the system / ADB shell hold DUMP -->
        <receiver
            android:name=".Release"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
