<?xml version="1.0" encoding="utf-8"?>
<!-- Everything keeps Android's own trust and its rules. The one exception: Apple's aerial videos
     (Music scenes) come from a server whose certificate is signed by Apple's own roots, which Android
     doesn't carry; those roots (res/raw/apple_root_ca*.cer, from apple.com/certificateauthority: the
     original, G2 and G3, so a rotation on Apple's side doesn't quietly end the videos) are trusted for
     that server alone, so the videos still arrive over a checked, encrypted connection. -->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="false">sylvan.apple.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/apple_root_ca" />
            <certificates src="@raw/apple_root_ca_g2" />
            <certificates src="@raw/apple_root_ca_g3" />
        </trust-anchors>
    </domain-config>
</network-security-config>
